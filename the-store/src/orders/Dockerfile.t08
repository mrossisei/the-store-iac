# syntax=docker/dockerfile:1
# Rebuild all sources and MapStruct mappings; retain the T07 runtime by digest.
# From repository root:
# docker build --network=host -f the-store/src/orders/Dockerfile.t08 \
#   --build-arg STORE_VERSION=v1 -t the-store/t08-orders-fixed:v1 the-store/src/orders
# Repeat with STORE_VERSION=v2 and the corresponding new tag.
ARG BASE_IMAGE=891200271122.dkr.ecr.us-east-1.amazonaws.com/the-store/orders@sha256:3082933925beae28baac5417a14bd3d93c1be972659b7bffc75a600b5fa6b356
FROM ${BASE_IMAGE} AS toolchain
USER root
RUN dnf --setopt=install_weak_deps=False install -y -q \
      java-21-amazon-corretto-devel tar gzip which \
    && dnf clean all

FROM toolchain AS build
WORKDIR /build
COPY .mvn .mvn
COPY mvnw pom.xml ./
COPY src ./src
RUN --mount=type=cache,id=t08-orders-maven,target=/root/.m2 \
    ./mvnw -B -ntp -Dtest=OrdersApplicationTests,OrdersMetricsTests,ChaosServiceIntegrationTest package

FROM ${BASE_IMAGE}
ARG STORE_VERSION=v1
LABEL org.opencontainers.image.version=$STORE_VERSION
COPY --chown=appuser:appuser --from=build /build/target/orders-0.0.1-SNAPSHOT.jar /app/app.jar
